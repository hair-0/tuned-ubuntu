# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

#          ~/.zshrc — oh-my-zsh configuration
#          环境自适应：WSL2/Ubuntu 22.04 与 Ubuntu 24.04+ 通用
# ============================================================================

# ---------------------------------------------------------------------------
# oh-my-zsh core
# ---------------------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"

# Theme. powerlevel10k is currently active; it needs a Nerd Font on the
# Windows side. To switch back to af-magic (no special font needed),
# comment out the p10k line and uncomment the af-magic line below.

#ZSH_THEME="af-magic"
#ZSH_THEME="agnoster"
ZSH_THEME="powerlevel10k/powerlevel10k"

# Update oh-my-zsh automatically, but ask first, every 13 days.
zstyle ':omz:update' mode reminder
zstyle ':omz:update' frequency 13

# Use hyphen-insensitive completion (_ and - are interchangeable).
HYPHEN_INSENSITIVE="true"

# Show red dots while waiting for completion to be computed.
COMPLETION_WAITING_DOTS="true"

# Don't mark untracked files as dirty — big repos stay fast.
DISABLE_UNTRACKED_FILES_DIRTY="true"

# Timestamp format used by `history`.
HIST_STAMPS="yyyy-mm-dd"

# ---------------------------------------------------------------------------
# Plugins
#   git                     — aliases + prompt branch info
#   sudo                    — press ESC twice to prepend `sudo`
#   extract                 — `x archive.tar.gz` extracts anything
#   colored-man-pages       — syntax colours in man pages
#   command-not-found       — suggests the apt package for unknown commands
#   z                       — `z proj` jumps to a frecent directory
#   zsh-completions         — extra completion definitions
#   zsh-autosuggestions     — inline grey suggestion from history
#   zsh-syntax-highlighting — live command colouring (MUST be last)
# ---------------------------------------------------------------------------
plugins=(
  git
  sudo
  extract
  colored-man-pages
  command-not-found
  z
  zsh-completions
  zsh-autosuggestions
  zsh-syntax-highlighting
)

# zsh-completions needs to be on fpath before compinit runs.
fpath+=("$ZSH/custom/plugins/zsh-completions/src")

source "$ZSH/oh-my-zsh.sh"

# ---------------------------------------------------------------------------
# History
# ---------------------------------------------------------------------------
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000

setopt EXTENDED_HISTORY          # record timestamp of each command
setopt INC_APPEND_HISTORY        # write to history file immediately, not on exit
setopt SHARE_HISTORY             # share history across concurrent shells
setopt HIST_IGNORE_DUPS          # don't record a command run twice in a row
setopt HIST_IGNORE_ALL_DUPS      # delete older duplicate entries
setopt HIST_IGNORE_SPACE         # commands starting with a space aren't saved
setopt HIST_REDUCE_BLANKS        # strip superfluous whitespace
setopt HIST_VERIFY               # expand !! but let you confirm before running

# ---------------------------------------------------------------------------
# Shell behaviour
# ---------------------------------------------------------------------------
setopt AUTO_CD                   # `cd` is optional: typing a dir name enters it
setopt AUTO_PUSHD                # every cd pushes onto the dir stack
setopt PUSHD_IGNORE_DUPS
setopt PUSHD_SILENT
setopt EXTENDED_GLOB             # ^, #, ~ globbing operators
setopt NO_CASE_GLOB              # case-insensitive globbing
setopt NUMERIC_GLOB_SORT         # file2 sorts before file10
setopt INTERACTIVE_COMMENTS      # allow # comments in interactive shells
setopt NO_BEEP

# ---------------------------------------------------------------------------
# Completion styling
# ---------------------------------------------------------------------------
# Case-insensitive matching, then partial-word, then substring.
zstyle ':completion:*' matcher-list \
  'm:{a-zA-Z}={A-Za-z}' \
  'r:|[._-]=* r:|=*' \
  'l:|=* r:|=*'

# Menu selection you can walk with arrow keys.
zstyle ':completion:*' menu select
zstyle ':completion:*' group-name ''
zstyle ':completion:*' verbose true

# Colourise completion candidates the same way `ls` colours files.
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# Nice section headers in the completion menu.
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'
zstyle ':completion:*:messages'     format '%F{purple}-- %d --%f'
zstyle ':completion:*:warnings'     format '%F{red}-- no matches --%f'
zstyle ':completion:*:corrections'  format '%F{green}-- %d (errors: %e) --%f'

# Complete `kill` with a process list.
zstyle ':completion:*:*:kill:*:processes' list-colors '=(#b) #([0-9]#)*=0=01;31'
zstyle ':completion:*:kill:*' command 'ps -u $USER -o pid,%cpu,tty,cputime,cmd'

# Cache slow completions (e.g. apt).
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "$HOME/.cache/zsh/zcompcache"

# Don't offer the current directory as an argument to cd ../<TAB>
zstyle ':completion:*:cd:*' ignore-parents parent pwd

# ---------------------------------------------------------------------------
# Colours
# ---------------------------------------------------------------------------
# Nicer `ls` palette; also feeds the completion list-colors above.
if command -v dircolors >/dev/null 2>&1; then
  eval "$(dircolors -b)"
fi

# WSL: default dir colour on a dark background is unreadable for
# other-writable dirs (green-on-blue). Tone those down.
export LS_COLORS="${LS_COLORS}:ow=1;34:tw=1;34"

# Colourise grep output.
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

# Make `less` render colour escape sequences (used by git, man, etc.).
export LESS='-R -F -X -i -M'

# ---------------------------------------------------------------------------
# Autosuggestions / syntax highlighting tuning
# ---------------------------------------------------------------------------
# Grey suggestion text. Bump the number up if it's too dim for your terminal.
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8'
# `completion` here forks a subshell on every keystroke — with a large PATH
# (WSL inherits all of Windows') that adds ~1s of input lag. `history` alone
# is instant. Press Tab when you actually want a completion-based suggestion.
ZSH_AUTOSUGGEST_STRATEGY=(history)
# Don't try to suggest for very long buffers (keeps pasting snappy).
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=60

# Accept the whole suggestion with Ctrl-Space, one word with Alt-Right.
bindkey '^ ' autosuggest-accept

# ---------------------------------------------------------------------------
# Key bindings
# ---------------------------------------------------------------------------
bindkey -e                                    # emacs-style keys

bindkey '^[[1;5C' forward-word                # Ctrl-Right
bindkey '^[[1;5D' backward-word               # Ctrl-Left
bindkey '^[[3;5~' kill-word                   # Ctrl-Delete
bindkey '^[[H'    beginning-of-line           # Home
bindkey '^[[F'    end-of-line                 # End
bindkey '^[[3~'   delete-char                 # Delete
bindkey '^[[Z'    reverse-menu-complete       # Shift-Tab walks menu backwards

# Up/Down search history using what you've already typed as a prefix.
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey '^[OA' up-line-or-beginning-search
bindkey '^[OB' down-line-or-beginning-search

# Edit the current command line in $EDITOR with Ctrl-X Ctrl-E.
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^X^E' edit-command-line

# ---------------------------------------------------------------------------
# Aliases
# ---------------------------------------------------------------------------
alias ls='ls --color=auto --group-directories-first'
alias ll='ls -alhF'
alias la='ls -A'
alias l='ls -CF'
alias lt='ls -alhFt'                          # newest last

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

alias df='df -h'
alias du='du -h'
alias free='free -h'
alias mkdir='mkdir -p'

# Safety nets on destructive commands — prompt before clobbering.
alias cp='cp -i'
alias mv='mv -i'
alias rm='rm -i'

alias zshrc='${EDITOR:-vim} ~/.zshrc'
alias reload='exec zsh'
alias path='echo -e ${PATH//:/\\n}'

# WSL: open the current directory in Windows Explorer.
if [[ -n "$WSL_DISTRO_NAME" ]] || grep -qi microsoft /proc/version 2>/dev/null; then
  alias e.='explorer.exe .'
fi

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
export EDITOR='vim'
export VISUAL="$EDITOR"
export PAGER='less'
export LANG='en_US.UTF-8'

# ---------------------------------------------------------------------------
# fzf — Ctrl-R history, Ctrl-T files, Alt-C cd
# ---------------------------------------------------------------------------
[[ -f "$HOME/.fzf.zsh" ]] && source "$HOME/.fzf.zsh"
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border --info=inline'

# ---------------------------------------------------------------------------
# Carried over from ~/.bashrc
# ---------------------------------------------------------------------------
# nvm (Node Version Manager) — 默认不加载，按机器启用：装好后在 ~/.zshrc.local 中加入：
#   export NVM_DIR="$HOME/.nvm"
#   [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
#   [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# ROS 2 — 自动适配已安装发行版（humble/jazzy/...），无 ROS 时静默跳过。
# 如需固定某个发行版，可在 ~/.zshrc.local 中覆盖。
for _ros_setup in /opt/ros/*/setup.zsh(N); do
  source "$_ros_setup"
  break
done
unset _ros_setup

# tk25 navigation workspace
[[ -f "$HOME/tinker_test/tk25_navigation/install/setup.zsh" ]] && source "$HOME/tinker_test/tk25_navigation/install/setup.zsh"

# kimi-code
export PATH="$HOME/.kimi-code/bin:$PATH"

# Prefer user-local commands (including the Linux build of Claude Code)
# over distro-managed binaries.
export PATH="$HOME/.local/bin:$PATH"

# ---------------------------------------------------------------------------
# Local overrides — put machine-specific or secret settings here so this
# file stays shareable. Not tracked, not overwritten.
# ---------------------------------------------------------------------------
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"




# ---------------------------------------------------------------------------
# conda — 自动探测 miniforge3 / miniconda3（装到哪个用哪个）
# 安装时不要运行 `conda init zsh`（会向 .zshrc 追加重复块，与 chezmoi 管理冲突）
# ---------------------------------------------------------------------------
for _conda_prefix in "$HOME/miniforge3" "$HOME/miniconda3"; do
  if [ -f "$_conda_prefix/etc/profile.d/conda.sh" ]; then
    . "$_conda_prefix/etc/profile.d/conda.sh"
    break
  fi
done
unset _conda_prefix

export CONDA_CHANGEPS1=false

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
